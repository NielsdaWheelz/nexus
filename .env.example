# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# App Name (used in logs, OpenAPI docs, etc.)
APP_NAME=nexus

# Environment: development, staging, production
# Default: development
ENV=development

# Debug mode (enables verbose logging, stack traces, etc.)
# Default: false
DEBUG=false

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Backend host to bind to (0.0.0.0 for all interfaces)
BACKEND_HOST=0.0.0.0

# Backend port
BACKEND_PORT=8000

# ============================================================================
# CORS CONFIGURATION (CRITICAL FOR FRONTEND)
# ============================================================================
# Format: JSON list or comma-separated (Pydantic will parse both)
# Dev example (JSON):
#   CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
# Prod example (single origin):
#   CORS_ORIGINS=["https://app.nexus.io"]
#
# ALWAYS update for your deployment!
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000"]

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection URL
# Format: postgresql+psycopg://user:password@host:port/dbname
# For local development with Docker:
DATABASE_URL=postgresql+psycopg://app_user:password@localhost:5432/nexus

# ============================================================================
# REDIS CONFIGURATION (Cache, Celery broker)
# ============================================================================

# Redis connection URL
# For local development with Docker:
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# AUTHENTICATION (Clerk OIDC)
# ============================================================================

# Get these from your Clerk dashboard at https://dashboard.clerk.com
# These are NOT sensitive (JWKS URL and issuer are public endpoints)

# Clerk JWKS endpoint for JWT validation
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Clerk token issuer
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# ============================================================================
# LLM PROVIDER CREDENTIALS (SENSITIVE - .env only, NEVER commit)
# ============================================================================

# OpenAI API Key (https://platform.openai.com/account/api-keys)
# Get at: https://platform.openai.com/api/keys
OPENAI_API_KEY=sk-...

# Anthropic API Key (https://console.anthropic.com)
# Get at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (https://aistudio.google.com)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# Primary LLM provider
# Options: openai, anthropic, gemini
LLM_PROVIDER=openai

# Model name for the provider
# OpenAI: gpt-4-turbo, gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# Gemini: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
LLM_MODEL=gpt-4-turbo

# ============================================================================
# EMBEDDINGS CONFIGURATION
# ============================================================================

# Embeddings provider
# Options: openai, local
EMBEDDINGS_PROVIDER=openai

# Embeddings model
# OpenAI: text-embedding-3-large (1536 dims), text-embedding-3-small (1536 dims)
EMBEDDINGS_MODEL=text-embedding-3-small

# Vector dimension (must match model output)
# OpenAI text-embedding-3-*: 1536 (adjustable, but default is 1536)
EMBEDDINGS_DIMENSION=1536

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# Storage backend for uploaded documents
# Options: local (filesystem), s3 (AWS S3)
STORAGE_BACKEND=local

# Local filesystem storage path (if STORAGE_BACKEND=local)
STORAGE_PATH=./storage/documents

# S3 Configuration (if STORAGE_BACKEND=s3)
S3_BUCKET=nexus-documents
S3_REGION=us-east-1

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Python logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
# Options: json (structured), text (human-readable)
LOG_FORMAT=json

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable RAG (Retrieval-Augmented Generation)
# Set to false to disable search/retrieval
ENABLE_RAG=true

# Enable embedding generation
# Set to false if using external embedding service
ENABLE_EMBEDDINGS=true
